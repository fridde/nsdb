{
    "require": {
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "easycorp/easyadmin-bundle": "5.0.*",
        "google/apiclient": "*",
        "knpuniversity/oauth2-client-bundle": "*",
        "league/oauth2-google": "^4.1",
        "nesbot/carbon": "^3.11",
        "stof/doctrine-extensions-bundle": "*",
        "symfony/all-my-sms-notifier": "*",
        "symfony/apache-pack": "*",
        "symfony/console": "*",
        "symfony/dotenv": "8.0.*",
        "symfony/flex": "*",
        "symfony/framework-bundle": "8.0.*",
        "symfony/mailer": "*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/runtime": "*",
        "symfony/security-bundle": "*",
        "symfony/serializer": "8.0.*",
        "symfony/slack-notifier": "*",
        "symfony/twig-bundle": "*",
        "symfony/webpack-encore-bundle": "*",
        "symfony/yaml": "*",
        "thenetworg/oauth2-azure": "*",
        "twig/extra-bundle": "^3.23"
    },
    "config": {
		"optimize-autoloader": false,
		"sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "auto-scripts": {
        },
        "google-cleanup": "Google\\Task\\Composer::cleanup",
        "pre-autoload-dump": "@google-cleanup"
    },
    "extra": {
        "symfony": {
            "require": "8.0.*",
            "docker": false,
            "allow-contrib": true
        },
		"google/apiclient-services": [
            "Calendar"
        ]
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "phpoffice/phpspreadsheet": "^5.4",
        "symfony/debug-bundle": "8.0.*",
        "symfony/maker-bundle": "^1.66",
        "symfony/web-profiler-bundle": "8.0.*"
    }
}
